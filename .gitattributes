# 强制 shell 脚本使用 LF 行尾，避免 Windows 编辑器写入 CRLF
# 导致在 Linux 上运行时报 `$'\r': command not found` 等错误
*.sh   text eol=lf
*.bash text eol=lf

# Python / 配置 / 文本类文件统一用 LF
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.env  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf

# Windows 专用脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件，不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.wav  binary
*.mp3  binary
*.mp4  binary
*.onnx binary
*.bin  binary
*.pt   binary
*.pth  binary
*.ckpt binary
*.safetensors binary
